[Unit]
Description=GLLMH valet for agent
PartOf=gllmh.target
Wants=gllmh-broker.service
After=gllmh-broker.service

[Service]
Type=notify
User=agent
ExecStart=/usr/bin/gllmh valet --user agent
WorkingDirectory=/home/gllmh-test/.gllmh
Restart=on-failure
TimeoutStopSec=10
NoNewPrivileges=yes

[Install]
WantedBy=gllmh.target
